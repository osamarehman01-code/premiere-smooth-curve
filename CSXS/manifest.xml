<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.pronk.smooth" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Premiere Smooth Curve" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.pronk.smooth.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.pronk.smooth.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <!-- Panel = dockable inside Premiere's workspace -->
          <Type>Panel</Type>
          <Menu>Premiere Smooth Curve</Menu>
          <Geometry>
            <Size><Width>810</Width><Height>600</Height></Size>
            <MinSize><Width>320</Width><Height>380</Height></MinSize>
            <MaxSize><Width>2400</Width><Height>1800</Height></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
